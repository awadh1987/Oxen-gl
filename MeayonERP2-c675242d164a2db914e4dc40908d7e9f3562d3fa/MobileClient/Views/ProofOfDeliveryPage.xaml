<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OxenGL.Mobile.ViewModels"
             x:Class="OxenGL.Mobile.Views.ProofOfDeliveryPage"
             Title="{Binding Title}"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Proof of Delivery (POD)" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White"/>
            
            <Label Text="Zero-trust cryptographic delivery capture with explicit GPS telemetry and encrypted media." 
                   FontSize="12" 
                   TextColor="#94A3B8"/>

            <!-- Trip ID -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Trip / Consignment Reference" TextColor="#CBD5E1" FontSize="13"/>
                <Entry Text="{Binding TripId}" 
                       Placeholder="e.g. TRIP-2026-0042" 
                       TextColor="White" 
                       BackgroundColor="#1E293B"/>
            </VerticalStackLayout>

            <!-- Recipient Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Recipient Name &amp; Title" TextColor="#CBD5E1" FontSize="13"/>
                <Entry Text="{Binding RecipientName}" 
                       Placeholder="e.g. Tariq Al-Mansoor (Warehouse Manager)" 
                       TextColor="White" 
                       BackgroundColor="#1E293B"/>
            </VerticalStackLayout>

            <!-- GPS Geolocation Capture -->
            <Border StrokeThickness="1" Stroke="#334155" BackgroundColor="#1E293B" Padding="14" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="GPS Geolocation Verification" FontAttributes="Bold" TextColor="#38BDF8" FontSize="14"/>
                    <Label Text="{Binding GpsStatusMessage}" TextColor="#E2E8F0" FontSize="12"/>
                    <Button Text="Acquire GPS (Consent Required)" 
                            Command="{Binding CaptureGpsCommand}" 
                            BackgroundColor="#0284C7" 
                            TextColor="White" 
                            CornerRadius="6" 
                            HeightRequest="40"/>
                </VerticalStackLayout>
            </Border>

            <!-- Camera / Photo POD Capture -->
            <Border StrokeThickness="1" Stroke="#334155" BackgroundColor="#1E293B" Padding="14" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Delivery Photo Proof (AES-256 Encrypted at Rest)" FontAttributes="Bold" TextColor="#38BDF8" FontSize="14"/>
                    <Label Text="{Binding CameraStatusMessage}" TextColor="#E2E8F0" FontSize="12"/>
                    <Button Text="Capture &amp; Encrypt Delivery Photo" 
                            Command="{Binding CapturePhotoCommand}" 
                            BackgroundColor="#0D9488" 
                            TextColor="White" 
                            CornerRadius="6" 
                            HeightRequest="40"/>
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Delivery Remarks" TextColor="#CBD5E1" FontSize="13"/>
                <Editor Text="{Binding Notes}" 
                        Placeholder="Seal intact, pallets checked and accepted..." 
                        HeightRequest="80" 
                        TextColor="White" 
                        BackgroundColor="#1E293B"/>
            </VerticalStackLayout>

            <!-- Submit Command -->
            <Button Text="Queue POD Command Offline" 
                    Command="{Binding SubmitPodCommand}" 
                    BackgroundColor="#10B981" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="48"/>

            <Label Text="{Binding StatusMessage}" 
                   TextColor="#FCD34D" 
                   FontSize="13" 
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
