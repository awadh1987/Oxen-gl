<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OxenGL.Mobile.ViewModels"
             x:Class="OxenGL.Mobile.Views.DashboardPage"
             Title="{Binding Title}"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Connectivity Status Banner -->
            <Border StrokeThickness="0"
                    BackgroundColor="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="{Binding IsOnline, Converter={StaticResource BoolToIconConverter}}" 
                           FontSize="24" 
                           VerticalOptions="Center" 
                           Margin="0,0,12,0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding ConnectionStatusText}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="White"/>
                        <Label Text="Offline operation queue active. Zero-Trust Local Vault enabled." 
                               FontSize="12" 
                               TextColor="#E2E8F0"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Financial Approval Lockdown Warning -->
            <Border StrokeThickness="1"
                    Stroke="#F59E0B"
                    BackgroundColor="#78350F"
                    Padding="14"
                    StrokeShape="RoundRectangle 10">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="🛡️" FontSize="20" VerticalOptions="Center"/>
                    <Label Text="{Binding FinancialApprovalWarning}" 
                           FontSize="12" 
                           TextColor="#FEF3C7" 
                           VerticalOptions="Center" 
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Metrics Cards Grid -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Pending Queue Card -->
                <Border Grid.Column="0" 
                        StrokeThickness="1" 
                        Stroke="#334155" 
                        BackgroundColor="#1E293B" 
                        Padding="16" 
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Pending Queue" TextColor="#94A3B8" FontSize="13"/>
                        <Label Text="{Binding PendingCount}" TextColor="#38BDF8" FontSize="28" FontAttributes="Bold"/>
                        <Label Text="Awaiting server sync" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Conflict Alerts Card -->
                <Border Grid.Column="1" 
                        StrokeThickness="1" 
                        Stroke="{Binding ConflictCount, Converter={StaticResource ConflictBorderConverter}}" 
                        BackgroundColor="#1E293B" 
                        Padding="16" 
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sync Conflicts" TextColor="#94A3B8" FontSize="13"/>
                        <Label Text="{Binding ConflictCount}" TextColor="#F87171" FontSize="28" FontAttributes="Bold"/>
                        <Label Text="Requires attention" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Sync Controls -->
            <Button Text="Sync Queue Now" 
                    Command="{Binding SyncNowCommand}"
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="8"
                    HeightRequest="48"/>

            <Label Text="{Binding LastSyncMessage}" 
                   TextColor="#CBD5E1" 
                   FontSize="12" 
                   HorizontalTextAlignment="Center"/>

            <!-- Conflict Alerts List -->
            <Label Text="Conflict Resolution Alerts" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   Margin="0,8,0,0"/>

            <CollectionView ItemsSource="{Binding ConflictAlerts}">
                <CollectionView.EmptyView>
                    <Label Text="No server conflicts detected. All synced operations in sync." 
                           TextColor="#64748B" 
                           FontSize="13" 
                           Margin="0,8"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1" 
                                Stroke="#EF4444" 
                                BackgroundColor="#2D1515" 
                                Padding="12" 
                                Margin="0,4" 
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding EntityType, StringFormat='Entity: {0}'}" 
                                       TextColor="#FCA5A5" 
                                       FontAttributes="Bold" 
                                       FontSize="13"/>
                                <Label Text="{Binding ConflictReason}" 
                                       TextColor="#FEE2E2" 
                                       FontSize="12"/>
                                <Label Text="{Binding OperationId, StringFormat='Op ID: {0}'}" 
                                       TextColor="#94A3B8" 
                                       FontSize="10"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Quick Action Buttons -->
            <Label Text="Offline Field Workflows" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="POD Sign" Clicked="OnNavigatePodClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="6" FontSize="12"/>
                <Button Grid.Column="1" Text="Weighment" Clicked="OnNavigateWeighmentClicked" BackgroundColor="#0284C7" TextColor="White" CornerRadius="6" FontSize="12"/>
                <Button Grid.Column="2" Text="Inspection" Clicked="OnNavigateInspectionClicked" BackgroundColor="#7C3AED" TextColor="White" CornerRadius="6" FontSize="12"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
