<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OxenGL.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OxenGL.Mobile.Views"
    FlyoutBehavior="Disabled"
    Title="OxenGL Mobile ERP">

    <TabBar>
        <Tab Title="Dashboard" Route="dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="POD" Route="pod">
            <ShellContent ContentTemplate="{DataTemplate views:ProofOfDeliveryPage}" />
        </Tab>
        <Tab Title="Weighment" Route="weighment">
            <ShellContent ContentTemplate="{DataTemplate views:FarmGateWeighmentPage}" />
        </Tab>
        <Tab Title="Inspection" Route="inspection">
            <ShellContent ContentTemplate="{DataTemplate views:MaintenanceInspectionPage}" />
        </Tab>
    </TabBar>

</Shell>
