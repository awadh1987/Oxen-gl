@page "/platform-admin/security-settings"
@using BlazorApp.Models
@using BlazorApp.Services
@inject SecurityApiClient SecurityApi
@inject TenantContextService TenantContext
@inject NavigationManager Navigation

<div class="security-dashboard-container p-6 max-w-7xl mx-auto space-y-8">
    <!-- Header with Super_Admin Badge -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Master Platform Security Dashboard</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200">
                    Super_Admin Restricted
                </span>
            </div>
            <p class="mt-1 text-sm text-slate-500">
                Centralized platform credential rotation, break-glass recovery code generation, and immutable system audit trails.
            </p>
        </div>
        <div class="mt-4 md:mt-0 flex items-center gap-3">
            <span class="text-xs text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">
                Logged in as: <strong class="text-slate-800">@TenantContext.CurrentUser.Email</strong> (@TenantContext.CurrentUser.Role)
            </span>
        </div>
    </div>

    @if (!TenantContext.IsSuperAdmin)
    {
        <!-- ACCESS DENIED GUARD -->
        <div class="p-6 bg-red-50 border border-red-200 rounded-2xl shadow-sm text-red-900 space-y-3" role="alert">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <h3 class="text-lg font-bold">Access Denied: Super_Admin Authorization Required</h3>
            </div>
            <p class="text-sm text-red-700">
                You are currently authenticated as role <code class="font-mono px-1 py-0.5 bg-red-100 rounded">@TenantContext.CurrentUser.Role</code>.
                The Master Platform Security settings are strictly restricted to the Super_Admin role. All unauthorized access attempts are intercepted and recorded in the server-side audit ledger.
            </p>
        </div>
    }
    else
    {
        <!-- Alert Messages -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="p-4 rounded-xl border @(isError ? "bg-red-50 border-red-200 text-red-800" : "bg-emerald-50 border-emerald-200 text-emerald-800") flex items-center justify-between">
                <span class="text-sm font-medium">@statusMessage</span>
                <button @onclick="() => statusMessage = null" class="text-xs underline ml-4">Dismiss</button>
            </div>
        }

        <!-- Recovery Codes Modal / Display Card -->
        @if (newRecoveryCodes != null && newRecoveryCodes.Count > 0)
        {
            <div class="p-6 bg-amber-50 border-2 border-amber-300 rounded-2xl shadow-md space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                        </svg>
                        <h2 class="text-lg font-bold text-amber-900">New Server Recovery Codes (One-Time Display)</h2>
                    </div>
                    <button @onclick="DismissRecoveryCodes" class="text-xs text-amber-800 font-semibold hover:underline">I have stored these safely [Dismiss]</button>
                </div>
                <p class="text-xs text-amber-700">
                    Store these 5 recovery codes in a secure, encrypted vault. They can be used for deployment break-glass operations when all identity providers are unreachable. These codes will not be shown again.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                    @for (int i = 0; i < newRecoveryCodes.Count; i++)
                    {
                        var codeItem = newRecoveryCodes[i];
                        <div class="bg-white px-4 py-2.5 rounded-lg border border-amber-200 shadow-sm text-center">
                            <span class="text-xs text-slate-400 block">Code #@(i + 1)</span>
                            <span class="font-mono text-sm font-bold text-slate-800 tracking-wider">@codeItem</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column: Password Rotation & Emergency Recovery Generator -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Credential Rotation Card -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                    <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <h2 class="text-base font-bold text-slate-800">Rotate Super Admin Credentials</h2>
                    </div>

                    <form @onsubmit="HandlePasswordRotate" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">New Permanent Password</label>
                            <input type="password" @bind="passwordModel.NewPassword" required minlength="8"
                                   placeholder="Min 8 chars, high-entropy"
                                   class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Confirm New Password</label>
                            <input type="password" @bind="confirmPassword" required minlength="8"
                                   placeholder="Re-enter password"
                                   class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div class="flex items-center gap-2 pt-1">
                            <input type="checkbox" id="regenCodes" @bind="passwordModel.RegenerateRecoveryCodes"
                                   class="rounded text-indigo-600 focus:ring-indigo-500 h-4 w-4 border-slate-300" />
                            <label for="regenCodes" class="text-xs text-slate-700">Regenerate 5 new Server Recovery Codes</label>
                        </div>

                        <button type="submit" disabled="@isSubmitting"
                                class="w-full py-2.5 px-4 rounded-xl text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 transition disabled:opacity-50 shadow-sm">
                            @(isSubmitting ? "Rotating Credentials..." : "Commit Credential Rotation")
                        </button>
                    </form>
                </div>

                <!-- Recovery Codes Quick Regenerate Card -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        <h2 class="text-base font-bold text-slate-800">Server Recovery Codes</h2>
                    </div>
                    <p class="text-xs text-slate-500">
                        Regenerate and invalidate all existing break-glass recovery codes for this server deployment.
                    </p>
                    <button @onclick="HandleGenerateRecoveryCodesOnly" disabled="@isSubmitting"
                            class="w-full py-2.5 px-4 rounded-xl text-sm font-semibold text-amber-900 bg-amber-100 hover:bg-amber-200 border border-amber-300 transition disabled:opacity-50">
                        Regenerate Recovery Codes Only
                    </button>
                </div>
            </div>

            <!-- Right Column: Immutable Security Audit Log -->
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <div>
                                <h2 class="text-base font-bold text-slate-800">Immutable Platform Security Audit Log</h2>
                                <p class="text-xs text-slate-400">Server-authoritative append-only logs for break-glass and privileged actions</p>
                            </div>
                        </div>
                        <button @onclick="LoadAuditLogs" disabled="@isLoadingLogs"
                                class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-300 transition">
                            @(isLoadingLogs ? "Refreshing..." : "Refresh Logs")
                        </button>
                    </div>

                    @if (auditLogs == null)
                    {
                        <div class="py-12 text-center text-slate-400 text-sm">Loading security audit trail...</div>
                    }
                    else if (auditLogs.Count == 0)
                    {
                        <div class="py-12 text-center text-slate-400 text-sm">No platform audit logs recorded yet.</div>
                    }
                    else
                    {
                        <div class="overflow-x-auto rounded-xl border border-slate-200">
                            <table class="min-w-full divide-y divide-slate-200 text-xs">
                                <thead class="bg-slate-50 text-slate-600">
                                    <tr>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Timestamp (UTC)</th>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Actor Email</th>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Action</th>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Outcome</th>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Endpoint</th>
                                        <th class="px-3.5 py-2.5 text-left font-semibold">Client IP</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 bg-white">
                                    @foreach (var log in auditLogs)
                                    {
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="px-3.5 py-2 text-slate-500 whitespace-nowrap font-mono text-[11px]">
                                                @log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                            </td>
                                            <td class="px-3.5 py-2 font-medium text-slate-800 whitespace-nowrap">
                                                @log.ActorEmail
                                            </td>
                                            <td class="px-3.5 py-2 text-slate-700 font-mono text-[11px] whitespace-nowrap">
                                                @log.Action
                                            </td>
                                            <td class="px-3.5 py-2 whitespace-nowrap">
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold @(log.Outcome == "SUCCESS" ? "bg-emerald-100 text-emerald-800" : "bg-red-100 text-red-800")">
                                                    @log.Outcome
                                                </span>
                                            </td>
                                            <td class="px-3.5 py-2 text-slate-500 font-mono text-[11px] truncate max-w-[140px]" title="@log.EndpointAccessed">
                                                @log.EndpointAccessed
                                            </td>
                                            <td class="px-3.5 py-2 text-slate-400 font-mono text-[11px] whitespace-nowrap">
                                                @(log.IpAddress ?? "-")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private PasswordRotateModel passwordModel = new();
    private string confirmPassword = string.Empty;
    private List<PlatformAuditLogItem>? auditLogs;
    private List<string>? newRecoveryCodes;
    private string? statusMessage;
    private bool isError = false;
    private bool isSubmitting = false;
    private bool isLoadingLogs = false;

    protected override async Task OnInitializedAsync()
    {
        if (TenantContext.IsSuperAdmin)
        {
            await LoadAuditLogs();
        }
    }

    private async Task LoadAuditLogs()
    {
        isLoadingLogs = true;
        try
        {
            auditLogs = await SecurityApi.GetPlatformAuditLogsAsync(100);
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to load audit logs: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoadingLogs = false;
        }
    }

    private async Task HandlePasswordRotate()
    {
        if (passwordModel.NewPassword != confirmPassword)
        {
            statusMessage = "Validation Error: Password confirmation does not match.";
            isError = true;
            return;
        }

        isSubmitting = true;
        statusMessage = null;
        try
        {
            var result = await SecurityApi.RotateSuperAdminPasswordAsync(passwordModel);
            statusMessage = result.Message;
            isError = false;
            newRecoveryCodes = result.RecoveryCodes;
            passwordModel = new();
            confirmPassword = string.Empty;
            await LoadAuditLogs();
        }
        catch (Exception ex)
        {
            statusMessage = $"Rotation Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleGenerateRecoveryCodesOnly()
    {
        isSubmitting = true;
        statusMessage = null;
        try
        {
            // Use current session credentials to regenerate codes
            var model = new PasswordRotateModel
            {
                NewPassword = null,
                RegenerateRecoveryCodes = true
            };
            var result = await SecurityApi.RotateSuperAdminPasswordAsync(model);
            newRecoveryCodes = result.RecoveryCodes;
            statusMessage = "Successfully generated 5 new Server Recovery Codes.";
            isError = false;
            await LoadAuditLogs();
        }
        catch (Exception ex)
        {
            statusMessage = $"Recovery Code Generation Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void DismissRecoveryCodes()
    {
        newRecoveryCodes = null;
    }
}
